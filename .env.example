# =========================================================================
# תבנית לקובץ .env של אפליקציית הליקוט (sweet-likut).
# להעתיק ל-.env בשרת ולמלא בערכים האמיתיים. הקובץ .env עצמו לא נכנס ל-git.
#
# שים לב: כל משתנה VITE_ נצרב ל-bundle וגלוי לכל גולש בדפדפן.
# אין להכניס לכאן סודות (מפתחות API, סיסמאות) — רק כתובות ציבוריות.
# =========================================================================

# ---- תת-התיקייה שממנה האפליקציה מוגשת. "/" = דומיין ייעודי ----
# חייב להתאים ל-RewriteBase שב-public/.htaccess.
VITE_APP_BASE_PATH=/sweet-likut/

# ---- ה-API של הבקאנד. חייב להסתיים ב-/api ----
VITE_MAIN_SERVER_URL=https://example.com/api
